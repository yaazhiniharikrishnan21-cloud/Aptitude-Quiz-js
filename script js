const quiz = [
    { q: "30% of 90 =?", o: ["30", "27", "29", "31"], a: 1 },
    { q: "The average of 10, 20, 30, 40, 50 is?", o: ["25", "30", "35", "40"], a: 1 },
    { q: "If 5 workers complete a job in 10 days, how many days for 10 workers?", o: ["5", "10", "15", "20"], a: 0 },
    { q: "What is 15% of 200?", o: ["15", "20", "30", "45"], a: 2 },
    { q: "A train travels 60 km in 1 hour. Speed in m/s?", o: ["16.67", "60", "100", "216"], a: 0 }
];

let i = 0, s = 0;

function loadQ() {
    document.getElementById("question").innerText = Q${i + 1}: ${quiz[i].q};
    let optDiv = document.getElementById("options");
    optDiv.innerHTML = "";
    quiz[i].o.forEach((opt, idx) => {
        let b = document.createElement("button");
        b.innerText = opt;
        b.style.cssText = "display:block;width:100%;padding:12px;margin:8px 0;border:none;border-radius:8px;background:#eee;cursor:pointer;text-align:left;";
        b.onclick = () => check(idx);
        optDiv.appendChild(b);
    });
    document.getElementById("nextBtn").style.display = "none";
}

function check(ans) {
    let btns = document.querySelectorAll("#options button");
    btns.forEach((b, idx) => {
        b.disabled = true;
        if (idx === quiz[i].a) b.style.background = "#4CAF50";
        else if (idx === ans) b.style.background = "#f44336";
    });
    if (ans === quiz[i].a) s++;
    document.getElementById("nextBtn").style.display = "block";
}

document.getElementById("nextBtn").onclick = () => {
    i++;
    if (i < quiz.length) loadQ();
    else {
        document.getElementById("quiz").style.display = "none";
        document.getElementById("result").style.display = "block";
        let msg = s >= 4? "Sabash Thalaivi! 🔥 You’re Job Ready!" : "Good! Keep practicing 💪";
        document.getElementById("result").innerHTML = <h2>${msg}</h2><p>Score: ${s}/${quiz.length}</p><button onclick="location.reload()">Try Again</button>;
    }
};

loadQ();
